// ── Sub-components for Dashboard ──────────────────────────────────────────────────

function MetricCard({ title, value, subtitle, icon: Icon, trend }: { 
  title: string; value: string; subtitle: string; icon: any; trend: 'up' | 'down' | 'stable' 
}) {
  return (
    <Card className=\"border-input shadow-premium-sm rounded-sm group hover:border-primary/50 transition-colors\">\n      <CardContent className=\"p-6\">\n        <div className=\"flex items-start justify-between mb-6\">\n          <div className=\"p-2 bg-brand-surface border border-input rounded-sm text-muted-foreground group-hover:text-primary transition-colors\">\n            <Icon size={20} strokeWidth={1.5} />\n          </div>\n          <Badge variant=\"neutral\" className=\"text-[9px] font-bold uppercase tracking-widest opacity-60\">Sincronizado</Badge>\n        </div>\n        <div className=\"space-y-1\">\n          <p className=\"text-xs font-bold text-muted-foreground uppercase tracking-wider\">{title}</p>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-bold text-brand-navy tracking-tighter\">{value}</span>\n          </div>\n          <p className=\"text-[11px] text-muted-foreground/70 font-medium\">{subtitle}</p>\n        </div>\n      </CardContent>\n    </Card>\n  )\n}

function QuickActionBtn({ label, icon: Icon, href }: { label: string; icon: any; href: string }) {
  return (
    <Link to={href} className=\"flex items-center gap-3 w-full p-3 rounded-sm border border-input bg-brand-background text-sm font-medium text-muted-foreground hover:text-brand-navy hover:bg-brand-surface hover:border-primary/50 transition-all shadow-sm group\">\n      <div className=\"p-1.5 bg-brand-surface rounded-sm group-hover:bg-white transition-colors border border-input\">\n        <Icon className=\"h-4 w-4\" />\n      </div>\n      {label}\n    </Link>\n  )\n}

function AlertBox({ type, title, message }: { type: 'info' | 'warning'; title: string; message: string }) {
  const isWarning = type === 'warning';
  return (
    <div className={cn(
      \"flex gap-4 p-5 rounded-sm border transition-all\",
      isWarning ? \"bg-amber-50/50 border-amber-200\" : \"bg-blue-50/50 border-blue-200\"
    )}>
      <div className={cn(
        \"h-8 w-8 rounded-sm flex items-center justify-center shrink-0\",
        isWarning ? \"bg-amber-100 text-amber-600\" : \"bg-blue-100 text-blue-600\"
      )}>
        <AlertCircle size={16} />
      </div>
      <div className=\"space-y-1\">
        <h4 className=\"text-sm font-bold text-brand-navy\">{title}</h4>
        <p className=\"text-xs text-muted-foreground leading-relaxed\">{message}</p>
      </div>
    </div>
  )
}

function cn(...classes: any[]) {
  return classes.filter(Boolean).join(' ');
}