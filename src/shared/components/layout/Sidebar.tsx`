import { NavLink } from 'react-router-dom'
import { X } from 'lucide-react'
import { useAuth } from '@/shared/hooks/useAuth'
import { cn } from '@/lib/utils'
import { navGroups, type NavItem } from './nav-items'
import { Button } from '@/components/ui/Button'

// ── UI Components Internos ────────────────────────────────────────────────────────

function NavGroup({ group, user, onClose }: { group: any, user: any, onClose?: () => void }) {
  function canSee(item: NavItem): boolean {
    if (!item.allowedRoles) return true
    if (!user) return false
    return item.allowedRoles.includes(user.role)
  }

  const visibleItems = group.items.filter(canSee)
  if (visibleItems.length === 0) return null

  return (
    <div className="space-y-3 mb-8">
      {group.label && (
        <p className="px-3 text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">
          {group.label}
        </p>
      )}
      <ul role="list" className="space-y-1">
        {visibleItems.map((item) => {
          const Icon = item.icon
          return (
            <li key={item.path}>
              {item.disabled ? (
                <div
                  className={cn(
                    'flex items-center gap-3 rounded-sm px-3 py-2',
                    'text-sm text-muted-foreground/40 cursor-not-allowed select-none',
                  )}
                  aria-disabled=\"true\"
                >
                  <Icon className=\"h-4 w-4 shrink-0\" aria-hidden />
                  <span className=\"font-medium\">{item.label}</span>
                  <span className=\"ml-auto text-[9px] italic opacity-50\">em breve</span>
                </div>
              ) : (
                <NavLink
                  to={item.path}
                  end={item.path === '/'}
                  onClick={onClose}
                  className={({ isActive }) =>
                    cn(
                      'flex items-center gap-3 rounded-sm px-3 py-2 transition-all duration-200 group',
                      'text-sm font-medium',
                      isActive
                        ? 'bg-brand-navy text-brand-surface shadow-premium-sm'
                        : 'text-muted-foreground hover:bg-brand-surface hover:text-foreground',
                    )
                  }
                >
                  <Icon className=\"h-4 w-4 shrink-0 transition-colors group-hover:text-primary\" aria-hidden />
                  {item.label}
                </NavLink>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  )
}

// ── Componentes Principais ─────────────────────────────────────────────────────────

function SidebarContent({ onClose }: { onClose?: () => void }) {
  const { user } = useAuth()

  return (
    <div className=\"flex h-full flex-col bg-brand-background border-r border-input\">
      {/* Logo / Brand Area */}
      <div className=\"flex h-24 items-center justify-between px-6 border-b border-input shrink-0 bg-brand-surface/50\">
        <div className=\"flex items-center gap-3">
          <div className=\"flex h-9 w-9 items-center justify-center rounded-sm bg-brand-navy shadow-premium-sm">
            <span className=\"text-brand-surface font-bold text-xs\">LM</span>
          </div>
          <div className=\"flex flex-col leading-tight">
            <span className=\"text-sm font-bold text-brand-navy tracking-tighter\">
              LOcAMed
            </span>
            <span className=\"text-[9px] text-muted-foreground font-bold uppercase tracking-widest\">
              Precision SaaS
            </span>
          </div>
        </div>

        {onClose && (
          <Button 
            variant=\"ghost\" 
            size=\"icon\" 
            onClick={onClose} 
            className=\"h-8 w-8 p-0 text-muted-foreground hover:text-foreground\"
          >
            <X className=\"h-4 w-4\" aria-hidden />
          </Button>
        )}
      </div>

      {/* Main Navigation */}
      <nav aria-label=\"Navegação principal\" className=\"flex-1 overflow-y-auto py-8 px-4 space-y-2 scrollbar-hide\">
        {navGroups.map((group, idx) => (
          <NavGroup key={idx} group={group} user={user} onClose={onClose} />
        ))}
      </nav>

      {/* Footer / User Profile Area */}
      <div className=\"border-t border-input p-4 shrink-0 bg-brand-surface/30">
        <div className=\"flex items-center gap-3 p-2 rounded-sm bg-brand-background border border-input shadow-sm">
          <div className=\"h-8 w-8 rounded-sm bg-brand-navy flex items-center justify-center text-brand-surface text-xs font-bold shrink-0">
            {user?.name?.charAt(0) || 'U'}
          </div>
          <div className=\"flex flex-col min-w-0">
            <span className=\"text-xs font-bold text-foreground truncate\">
              {user?.name || 'Usuário'}
            </span>
            <span className=\"text-[10px] text-muted-foreground truncate uppercase\">
              {user?.role || 'Operador'}
            </span>
          </div>
        </div>
        <p className=\"mt-4 text-[9px] text-muted-foreground/50 text-center font-medium tracking-tight\">
          &copy; {new Date().getFullYear()} LOcAMed Precision
        </p>
      </div>
    </div>
  )
}

export function Sidebar() {
  return (
    <aside
      className={cn(
        'hidden lg:flex flex-col',
        'w-64 shrink-0 h-screen sticky top-0',
        'z-20',
      )}
      aria-label=\"Sidebar\"
    >
      <SidebarContent />
    </aside>
  )
}

export function MobileSidebar({ isOpen, onClose }: { isOpen: boolean; onClose: () => void }) {
  if (!isOpen) return null

  return (
    <>
      <div
        className=\"fixed inset-0 z-40 bg-brand-navy/40 backdrop-blur-sm lg:hidden\"
        aria-hidden=\"true\"
        onClick={onClose}
      />
      <aside
        className={cn(
          'fixed inset-y-0 left-0 z-50 flex flex-col',
          'w-64 bg-brand-background border-r border-input shadow-2xl',
          'lg:hidden',
          isOpen ? 'translate-x-0' : '-translate-x-full',
          'transition-transform duration-300 ease-out',
        )}
        aria-label=\"Menu mobile\"
        role=\"dialog\"
        aria-modal=\"true\"
      >
        <SidebarContent onClose={onClose} />
      </aside>
    </>\n  )
}